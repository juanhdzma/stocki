DB_PATH=data/stockdesk.db

# Yahoo Finance auth cookies (required when fc.yahoo.com is blocked)
# How to get them:
#   1. Open Chrome → https://finance.yahoo.com and log in (or just visit)
#   2. DevTools (F12) → Application → Cookies → https://finance.yahoo.com
#   3. Find cookies named exactly "T" and "Y" and copy their values
YAHOO_COOKIE_T=
YAHOO_COOKIE_Y=
